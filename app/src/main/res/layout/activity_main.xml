<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#071A25">
    <LinearLayout
        android:orientation="vertical"
        android:paddingStart="52dp"
        android:paddingEnd="52dp"
        android:paddingTop="30dp"
        android:paddingBottom="36dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="HRT • Budzik radiowy" android:textColor="#58D6C2"
            android:textSize="32sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Wersja v0.4 TESTOWA: lokalny ADB, glosnosc narastajaca oraz opcjonalny tryb Tylko dzwiek. Glosnosc procentowa dotyczy odtwarzacza, a nie ustawienia glosnikow TCL. Nie uzywaj jako jedynego budzika."
            android:textColor="#DDE5EA" android:textSize="17sp" android:paddingTop="10dp" />
        <RadioGroup android:id="@+id/radioStations"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:paddingTop="15dp">
            <RadioButton android:id="@+id/radio1" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="HR1" android:textSize="22sp" android:checked="true" android:paddingEnd="30dp" />
            <RadioButton android:id="@+id/radio2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="HR2" android:textSize="22sp" android:paddingEnd="30dp" />
            <RadioButton android:id="@+id/radio3" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="HR3" android:textSize="22sp" android:paddingEnd="30dp" />
            <RadioButton android:id="@+id/radioCustom" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Własny URL" android:textSize="22sp" />
        </RadioGroup>
        <EditText android:id="@+id/customUrl" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:singleLine="true"
            android:hint="https://... adres strumienia" android:textSize="17sp"
            android:inputType="textUri" />
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="8dp">
            <Button android:id="@+id/btnPlay" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="▶ Odtwórz teraz" android:textAllCaps="false" android:textSize="18sp" />
            <Button android:id="@+id/btnStop" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="■ Zatrzymaj" android:textAllCaps="false" android:textSize="18sp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Glosnosc budzika (wzmocnienie odtwarzacza 0-100%; glosnosc TCL ustawisz pilotem)"
            android:textColor="#58D6C2" android:textSize="21sp" android:paddingTop="15dp" />
        <CheckBox android:id="@+id/rampEnabled"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Plynne narastanie glosnosci po alarmie" android:checked="true"
            android:textSize="19sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Start %: " android:textSize="18sp" />
            <EditText android:id="@+id/volumeStart" android:layout_width="95dp"
                android:layout_height="wrap_content" android:text="5" android:singleLine="true"
                android:inputType="number" android:textSize="20sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="    Cel %: " android:textSize="18sp" />
            <EditText android:id="@+id/volumeTarget" android:layout_width="95dp"
                android:layout_height="wrap_content" android:text="45" android:singleLine="true"
                android:inputType="number" android:textSize="20sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="    Minuty: " android:textSize="18sp" />
            <EditText android:id="@+id/rampMinutes" android:layout_width="95dp"
                android:layout_height="wrap_content" android:text="10" android:singleLine="true"
                android:inputType="number" android:textSize="20sp" />
        </LinearLayout>
        <CheckBox android:id="@+id/audioOnly"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Po wybudzeniu i rozpoczeciu radia wlacz TCL Tylko dzwiek (wygas ekran)"
            android:checked="false" android:textSize="19sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btnSaveOptions" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Zapisz ustawienia"
                android:textAllCaps="false" android:textSize="18sp" />
            <Button android:id="@+id/btnTestAudioOnly" android:layout_width="wrap_content"
                android:layout_height="wrap_content" android:text="Test wygaszenia teraz"
                android:textAllCaps="false" android:textSize="18sp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Lokalny ADB — najpierw autoryzacja na TCL (wymaga Debugowania USB)"
            android:textColor="#58D6C2" android:textSize="21sp" android:paddingTop="15dp" />
        <Button android:id="@+id/btnLocalAdb" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Sprawdź / autoryzuj lokalne ADB" android:textAllCaps="false" android:textSize="18sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Test wybudzania ze standby" android:textColor="#58D6C2" android:textSize="23sp" android:paddingTop="15dp"/>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/btnTest2" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Test za 2 min" android:textAllCaps="false" android:textSize="18sp" />
            <Button android:id="@+id/btnTest15" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Test za 15 min" android:textAllCaps="false" android:textSize="18sp" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Budzik tygodniowy • wpisz godzinę HH:mm" android:textColor="#58D6C2"
            android:textSize="22sp" android:paddingTop="15dp" />
        <EditText android:id="@+id/timeText" android:layout_width="220dp" android:layout_height="wrap_content"
            android:hint="06:30" android:text="06:30" android:singleLine="true"
            android:inputType="text" android:textSize="24sp"/>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <CheckBox android:id="@+id/day1" android:text="Pn" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
            <CheckBox android:id="@+id/day2" android:text="Wt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
            <CheckBox android:id="@+id/day3" android:text="Śr" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
            <CheckBox android:id="@+id/day4" android:text="Cz" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
            <CheckBox android:id="@+id/day5" android:text="Pt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
            <CheckBox android:id="@+id/day6" android:text="So" android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <CheckBox android:id="@+id/day7" android:text="Nd" android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout android:orientation="horizontal" android:layout_width="match_parent" android:layout_height="wrap_content">
            <Button android:id="@+id/btnSchedule" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Ustaw tygodniowy" android:textAllCaps="false" android:textSize="18sp" />
            <Button android:id="@+id/btnCancel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Anuluj alarm" android:textAllCaps="false" android:textSize="18sp" />
            <Button android:id="@+id/btnPermissions" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Uprawnienia" android:textAllCaps="false" android:textSize="18sp" />
        </LinearLayout>
        <TextView android:id="@+id/statusText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Status" android:textColor="#D9F4ED" android:textSize="18sp" android:paddingTop="12dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Dziennik zdarzeń (po próbie włącz TV pilotem i wróć tutaj):"
            android:textColor="#58D6C2" android:textSize="18sp" android:paddingTop="12dp" />
        <TextView android:id="@+id/logText" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="#DDE5EA" android:textSize="14sp" android:fontFamily="monospace"
            android:textIsSelectable="true" android:paddingTop="8dp" />
    </LinearLayout>
</ScrollView>
